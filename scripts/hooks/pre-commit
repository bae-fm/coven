#!/bin/bash
# coven pre-commit: format, lint and the checker; tests only with COVEN_HOOK_TESTS=1.
set -e

TMPFILE=$(mktemp)
cleanup() { rm -f "$TMPFILE"; }
trap cleanup EXIT

CHANGED_FILES=$(git --no-pager diff --cached --name-only)

# The checks below build into the checkout's build output paths.
./scripts/build-layout.sh

run_check() {
    local name="$1"
    shift
    echo "Running $name..."
    if "$@" > "$TMPFILE" 2>&1; then
        return 0
    else
        echo ""
        echo "$name failed:"
        cat "$TMPFILE"
        return 1
    fi
}

source "$(dirname "$0")/restage-formatted.sh"

# Formatting, clippy and the checker's rules run before every commit (Appendix F.6).
snapshot_staged_files
run_check "cargo fmt" cargo fmt --all || {
    echo "cargo fmt failed"
    exit 1
}
restage_and_fail_if_formatted "cargo fmt" || exit 1

run_check "formatting, clippy and the checker" scripts/check-fast.sh || {
    echo "Fix the findings above and try again"
    exit 1
}

# The check scripts' own tests run when a commit changes what they test.
if echo "$CHANGED_FILES" | grep -qE '^scripts/(check-spec\.py|check_spec_tests\.py)$'; then
    run_check "check-spec.py's tests" python3 scripts/check_spec_tests.py || {
        echo "Fix the findings above and try again"
        exit 1
    }
fi
if echo "$CHANGED_FILES" | grep -qE '^scripts/(check-fast\.sh|cargo\.sh|check_fast_tests\.py)$'; then
    run_check "check-fast.sh's tests" python3 scripts/check_fast_tests.py || {
        echo "Fix the findings above and try again"
        exit 1
    }
fi

if echo "$CHANGED_FILES" | grep -qE '^scripts/(hooks/restage-formatted\.sh|hooks/pre-commit|hook_restage_tests\.py)$'; then
    run_check "the pre-commit restage's tests" python3 scripts/hook_restage_tests.py || {
        echo "Fix the findings above and try again"
        exit 1
    }
fi

# Full test runs are periodic, not per-commit: CI runs the complete suite on
# three platforms at every push. Set COVEN_HOOK_TESTS=1 to run it locally too.
if [ "${COVEN_HOOK_TESTS:-0}" = "1" ]; then
    run_check "cargo test" scripts/cargo.sh test --all-features || {
        echo "Tests failed"
        exit 1
    }
fi

echo "All checks passed"
